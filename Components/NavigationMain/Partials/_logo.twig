<a class="logo" href="{{ site.link|e('esc_url') }}">
  {% if logoIcon and logoWordmark %}
    <img class="logo-icon" src="{{ logoIcon.src }}" width="{{ logoIcon.width }}" height="{{ logoIcon.height }}" fetchpriority="high" alt="">
    <img class="logo-wordmark" src="{{ logoWordmark.src }}" width="{{ logoWordmark.width }}" height="{{ logoWordmark.height }}" fetchpriority="high" alt="{{ logo.alt }}">
  {% else %}
    <img class="logo-image" width="156" height="46" src="{{ logo.src }}" fetchpriority="high" alt="{{ logo.alt }}">
  {% endif %}
</a>
